# Public deployment values used by Next.js and Convex Auth.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Keep AGENTMAIL_API_KEY, AGENTMAIL_WEBHOOK_SECRET, AGENTMAIL_INBOX_ID,
# FIRECRAWL_API_KEY, and FIRECRAWL_WEBHOOK_SECRET in Convex deployment
# environment variables. Do not add them to this file or .env.local.
