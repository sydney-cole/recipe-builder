# Public deployment values used by Next.js and Convex Auth.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Server-only Convex deployment variables (names only; never put their values here):
# AGENTMAIL_API_KEY, AGENTMAIL_WEBHOOK_SECRET, AGENTMAIL_INBOX_ID,
# AGENTMAIL_INBOX_EMAIL, FIRECRAWL_API_KEY, OPENAI_API_KEY,
# OPENAI_RECIPE_MODEL.
